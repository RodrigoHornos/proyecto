[MASTER]
# Archivos o directorios a ignorar
ignore=.venv,htmlcov,.pytest_cache,__pycache__

[MESSAGES CONTROL]
# Deshabilitar advertencias comunes que no son críticas
disable=
    C0111,  # missing-docstring
    C0103,  # invalid-name (nombres de variables cortas)
    R0903,  # too-few-public-methods
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    W0212,  # protected-access
    W0613,  # unused-argument (común en fixtures de pytest)
    W0621,  # redefined-outer-name (común en fixtures de pytest)
    C0301,  # line-too-long
    R0801,  # duplicate-code
    R0902,  # too-many-instance-attributes
    R0904,  # too-many-public-methods
    R0911,  # too-many-return-statements
    R0912,  # too-many-branches
    R0915,  # too-many-statements
    W0511,  # fixme (comentarios TODO)
    C0302,  # too-many-lines
    C0415,  # import-outside-toplevel

[FORMAT]
# Longitud máxima de línea
max-line-length=120

[DESIGN]
# Límites más flexibles
max-args=10
max-locals=20
max-returns=10
max-branches=15
max-statements=60
max-attributes=15
max-public-methods=25

[BASIC]
# Permitir nombres de variables cortos comunes
good-names=i,j,k,x,y,z,df,ax,fig,e,f,n,m,_

[SIMILARITIES]
# Ignorar similitudes en imports y docstrings
ignore-imports=yes
ignore-docstrings=yes

; Made with Bob
